<Window x:Class="RemoteConnectionManager.App.Views.MoveToWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:RemoteConnectionManager.App.Services"
        xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
        Title="Move" Width="460" Height="520" MinHeight="300" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DarkWindow}">
    <DockPanel Margin="20,16">
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="FilterBox" Padding="24,3,6,3" TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"
                     AutomationProperties.Name="Filter folders" />
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0"
                       Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
            <TextBlock x:Name="FilterHint" Text="Filter folders" Style="{StaticResource Muted}" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            <Button x:Name="OkButton" Content="Move" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Margin="8,0,0,0"
                    IsEnabled="False" Click="Ok_Click" />
        </StackPanel>
        <ListBox x:Name="Targets" SelectionMode="Single" SelectionChanged="Targets_SelectionChanged" MouseDoubleClick="Targets_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Folders">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsEnabled" Value="{Binding Allowed}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type services:MoveTarget}">
                    <StackPanel x:Name="Row" Orientation="Horizontal" Margin="{Binding Depth, Converter={x:Static views:DepthToIndentConverter.Instance}}">
                        <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" Text="&#xE8D5;" FontSize="13" Margin="0,0,7,0" Foreground="{StaticResource Icon.Folder}" />
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Note, StringFormat=({0})}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Folder}" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Text" Value="&#xE80F;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Allowed}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
