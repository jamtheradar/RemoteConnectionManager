<UserControl x:Class="RemoteConnectionManager.App.Views.WebAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:WebAppTabViewModel}"
             Background="{StaticResource Chrome.Background}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisLocal" />
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <DataTemplate x:Key="PropertyRowTemplate" DataType="{x:Type vm:PropertyRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section switcher, slot picker and account -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasSlots, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Slot" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot, Mode=TwoWay}" DisplayMemberPath="Title" MinWidth="130" Height="24"
                                  VerticalAlignment="Center" ToolTip="Deployment slot. Settings, start, stop and restart apply to the slot shown here." />
                        <Rectangle Width="1" Height="14" Fill="{StaticResource Chrome.Border}" Margin="8,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource Icon.Azure}" />
                    <TextBlock Text="{Binding AccountText}" FontSize="11" VerticalAlignment="Center" ToolTip="The Azure account this app is read with">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsSignIn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72E;" FontSize="11" Padding="4,2" MinWidth="0" Margin="4,0,0,0"
                            ToolTip="Sign in again" Command="{Binding SignInCommand}" Foreground="{StaticResource Chrome.Warn}"
                            Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabStripItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WebAppSection}">
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                                <TextBlock Style="{StaticResource TypedGlyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- App actions -->
        <Border Grid.Row="1" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6,8,0">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Height="2" Margin="-8,4,-8,0">
                    <ProgressBar IsIndeterminate="True" Height="2" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="{Binding BusyText}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Chrome.Text}" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BusyText}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource BarButton}" Content="Cancel" Margin="8,0,0,0" Padding="8,1" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- State badge -->
                    <Border CornerRadius="3" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" BorderThickness="1"
                            Visibility="{Binding StateText, Converter={StaticResource StringToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Chrome.Border}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Chrome.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Chrome.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StateText}" FontSize="11" AutomationProperties.Name="State">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Chrome.Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Chrome.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource AccentButton}" Padding="10,3" Margin="0,0,6,0" Command="{Binding BrowseCommand}" IsEnabled="{Binding CanBrowse}"
                            ToolTip="Open the app's default domain in the default browser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="11" Foreground="{StaticResource Chrome.AccentText}" Margin="0,0,6,0" />
                            <TextBlock Text="Browse" Foreground="{StaticResource Chrome.AccentText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Content="Start" Command="{Binding StartCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisLocal}}" />
                    <Button Style="{StaticResource BarButton}" Content="Stop" Command="{Binding StopCommand}" Foreground="{StaticResource Chrome.Danger}"
                            Visibility="{Binding IsStopped, Converter={StaticResource InverseBoolToVisLocal}}" />
                    <Button Style="{StaticResource BarButton}" Content="Restart" Command="{Binding RestartCommand}" />
                    <Rectangle Width="1" Margin="6,2" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource BarButton}" Content="Open in portal" Command="{Binding OpenInPortalCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Copy resource ID" Command="{Binding CopyResourceIdCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error bar -->
        <Border Grid.Row="2" Background="#3a1d1f" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" MinWidth="0" ToolTip="Dismiss" Command="{Binding DismissErrorCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Sign in again" Margin="8,0,6,0" Command="{Binding SignInCommand}"
                        Visibility="{Binding ErrorNeedsSignIn, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" HorizontalAlignment="Left" Foreground="{StaticResource Chrome.Danger}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Overview -->
        <Grid Grid.Row="3" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="{Binding Overview.Name}" Style="{StaticResource Heading}" FontSize="20" />
                        <TextBlock Text="{Binding Overview.SlotName, StringFormat='{}/{0}'}" Style="{StaticResource Heading}" FontSize="20" Foreground="{StaticResource Chrome.TextMuted}"
                                   Visibility="{Binding Overview.SlotName, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}" Margin="0,0,0,14" />

                    <TextBlock Text="Essentials" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding EssentialsLeft}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding EssentialsRight}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                    </Grid>

                    <TextBlock Text="Configuration and networking" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ConfigurationRows}" ItemTemplate="{StaticResource PropertyRowTemplate}" MaxWidth="900" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       Visibility="{Binding ShowBusyOverlay, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />
        </Grid>

        <!-- App settings and connection strings -->
        <Grid Grid.Row="3" Visibility="{Binding IsSettingsList, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding PendingText}" Foreground="{StaticResource Chrome.Warn}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{StaticResource BarButton}" Content="Discard" Command="{Binding DiscardCommand}" />
                        <Button Style="{StaticResource AccentButton}" Padding="12,3" Margin="0" Command="{Binding SaveCommand}"
                                ToolTip="Checks nobody else changed the settings, then saves. Saving app settings or connection strings restarts the app.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="11" Foreground="{StaticResource Chrome.AccentText}" Margin="0,0,6,0" />
                                <TextBlock Text="Save" Foreground="{StaticResource Chrome.AccentText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BarButton}" Command="{Binding AddCommand}" IsEnabled="{Binding SettingsLoaded}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding AddLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BarButton}" Command="{Binding ToggleValuesCommand}" IsEnabled="{Binding SettingsLoaded}"
                                ToolTip="Values hide again after two minutes. Key Vault references always show.">
                            <Grid>
                                <TextBlock Text="Show values" Visibility="{Binding ValuesShown, Converter={StaticResource InverseBoolToVisLocal}}" />
                                <TextBlock Text="Hide values" Visibility="{Binding ValuesShown, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <Rectangle Width="1" Margin="6,2" Fill="{StaticResource Chrome.Border}" />
                        <Grid Width="220" Margin="4,0,0,0">
                            <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                            <TextBlock Text="Filter by name" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,5" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Source" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="Slot" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>
                    <Grid>
                        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingRowViewModel}">
                                    <Grid AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Name}" />
                                        <TextBlock x:Name="ValueText" Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="SourceText" Grid.Column="2" Text="{Binding SourceText}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SlotText}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="4" Text="{Binding ChangeText}" Foreground="{StaticResource Chrome.Warn}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyVaultReference}" Value="True">
                                            <Setter TargetName="SourceText" Property="Foreground" Value="{StaticResource Icon.Vault}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                   Visibility="{Binding EmptyText, Converter={StaticResource StringToVis}}" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                                   Visibility="{Binding ShowBusyOverlay, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />
                        <Border Visibility="{Binding HasSettingsError, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,40,20,0"
                                MaxWidth="520" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="1" CornerRadius="3" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding SettingsError}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource BarButton}" Content="Try again" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Chrome.Border}" />

                <!-- Edit pane -->
                <Border Grid.Column="2" Background="{StaticResource Chrome.Panel}">
                    <Grid>
                        <TextBlock Text="Select a setting to see or change it." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisLocal}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="16,14">
                                <TextBlock Text="Name" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SelectedRow.Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,12" />

                                <TextBlock Text="Value" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SelectedRow.Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                         TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                         Visibility="{Binding SelectedRow.ShowsValue, Converter={StaticResource BoolToVis}}" />
                                <Border Background="{StaticResource Surface.Input}" BorderBrush="{StaticResource Surface.InputBorder}" BorderThickness="1" CornerRadius="3" Padding="8,8" Margin="0,0,0,6"
                                        Visibility="{Binding SelectedRow.ShowsValue, Converter={StaticResource InverseBoolToVisLocal}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Show value" Margin="0" Command="{Binding RevealSelectedCommand}" />
                                        <TextBlock Text="Hidden." Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <!-- Key Vault reference -->
                                <Border BorderBrush="{StaticResource Icon.Vault}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,4,0,8"
                                        Visibility="{Binding SelectedRow.IsKeyVaultReference, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Open vault" Margin="8,0,0,0" Command="{Binding OpenReferencedVaultCommand}" />
                                        <StackPanel>
                                            <TextBlock Text="Key Vault reference" FontWeight="SemiBold" Foreground="{StaticResource Icon.Vault}" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap">
                                                <Run Text="Secret" />
                                                <Run Text="{Binding SelectedRow.VaultReference.SecretName, Mode=OneWay}" />
                                                <Run Text="in" />
                                                <Run Text="{Binding SelectedRow.VaultReference.VaultUri, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <StackPanel Visibility="{Binding SelectedRow.IsConnectionString, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                                    <TextBlock Text="Type" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding ConnectionStringTypes}" SelectedItem="{Binding SelectedRow.Type, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="180" />
                                </StackPanel>

                                <CheckBox Content="Deployment slot setting" IsChecked="{Binding SelectedRow.SlotSetting, Mode=TwoWay}" Margin="0,6,0,4"
                                          ToolTip="Stays with this slot when slots are swapped. The list of slot settings is kept on the production site." />

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Command="{Binding CopyValueCommand}"
                                            ToolTip="Copy the value. The clipboard clears itself after 30 seconds and the value stays out of clipboard history.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Copy value" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Remove" Command="{Binding RemoveCommand}" Foreground="{StaticResource Chrome.Danger}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Changes are kept here until you press Save. Save checks nobody else changed the settings since they were loaded." />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="4" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource Chrome.Ok}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
