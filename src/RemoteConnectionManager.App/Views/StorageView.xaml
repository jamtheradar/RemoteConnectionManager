<UserControl x:Class="RemoteConnectionManager.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:StorageTabViewModel}"
             Background="{StaticResource Chrome.Background}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisLocal" />
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <DataTemplate x:Key="PropertyRowTemplate" DataType="{x:Type vm:PropertyRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:PropertyRow}">
            <StackPanel Margin="0,0,0,7">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11" />
                <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section switcher and account -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource Icon.Azure}" />
                    <TextBlock Text="{Binding AccountText}" FontSize="11" VerticalAlignment="Center" ToolTip="The Entra ID account the blobs are read with. Storage Blob Data roles decide what it can do.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsSignIn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72E;" FontSize="11" Padding="4,2" MinWidth="0" Margin="4,0,0,0"
                            ToolTip="Sign in again" Command="{Binding SignInCommand}" Foreground="{StaticResource Chrome.Warn}"
                            Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabStripItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StorageSection}">
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                                <TextBlock Style="{StaticResource TypedGlyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Account actions -->
        <Border Grid.Row="1" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6,8,0">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Height="2" Margin="-8,4,-8,0">
                    <ProgressBar IsIndeterminate="True" Height="2" BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="{Binding BusyText}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Chrome.Text}" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BusyText}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource BarButton}" Content="Cancel" Margin="8,0,0,0" Padding="8,1" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AccountId.AccountName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border CornerRadius="3" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource Chrome.Border}"
                            Visibility="{Binding NamespaceText, Converter={StaticResource StringToVis}}"
                            ToolTip="With a hierarchical namespace, folders are real and rename is a single quick call. Without one, a folder is just a shared name prefix.">
                        <TextBlock Text="{Binding NamespaceText}" FontSize="11" Style="{StaticResource Muted}" />
                    </Border>
                    <Button Style="{StaticResource BarButton}" Content="Open in portal" Command="{Binding OpenInPortalCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Copy resource ID" Command="{Binding CopyResourceIdCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error bar -->
        <Border Grid.Row="2" Background="#3a1d1f" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" MinWidth="0" ToolTip="Dismiss" Command="{Binding DismissErrorCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Sign in again" Margin="8,0,6,0" Command="{Binding SignInCommand}"
                        Visibility="{Binding ErrorNeedsSignIn, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" HorizontalAlignment="Left" Foreground="{StaticResource Chrome.Danger}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Overview -->
        <Grid Grid.Row="3" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AccountId.AccountName}" Style="{StaticResource Heading}" FontSize="20" />
                    <TextBlock Text="Storage account" Style="{StaticResource Muted}" Margin="0,0,0,14" />
                    <TextBlock Text="Essentials" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding OverviewRows}" ItemTemplate="{StaticResource PropertyRowTemplate}" Margin="0,0,0,18" />
                    <TextBlock Text="Data protection and access" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ProtectionRows}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       Visibility="{Binding ShowBusyOverlay, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />
        </Grid>

        <!-- Containers and blobs -->
        <Grid Grid.Row="3" Visibility="{Binding IsBlobs, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Containers -->
            <DockPanel Background="{StaticResource Chrome.Panel}">
                <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11" ToolTip="New container" Command="{Binding NewContainerCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="11" ToolTip="Delete container" Command="{Binding DeleteContainerCommand}"
                                    Foreground="{StaticResource Chrome.Danger}" />
                        </StackPanel>
                        <TextBlock Text="Containers" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid DockPanel.Dock="Top" Margin="8,6">
                    <TextBox x:Name="ContainerFilterBox" Text="{Binding ContainerFilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12"
                             AutomationProperties.Name="Filter containers" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                    <TextBlock Text="Filter" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=ContainerFilterBox, Converter={StaticResource EmptyToVis}}" />
                </Grid>
                <Grid>
                    <ListBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Containers">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContainerRow}">
                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Note}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="12" Foreground="{StaticResource Icon.Storage}" Margin="0,0,7,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="10" Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding ContainersEmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="12,20" TextAlignment="Center"
                               Visibility="{Binding ContainersEmptyText, Converter={StaticResource StringToVis}}" IsHitTestVisible="False" />
                    <Border Visibility="{Binding HasContainersError, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" Margin="8,12"
                            BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="1" CornerRadius="3" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding ContainersError}" TextWrapping="Wrap" FontSize="12" />
                            <Button Style="{StaticResource BarButton}" Content="Try again" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Chrome.Border}" />

            <!-- Listing -->
            <DockPanel Grid.Column="2">
                <!-- Path and actions -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE74A;" FontSize="12" ToolTip="Up one folder (Backspace)" Command="{Binding UpCommand}" Margin="0,0,6,0" />
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Padding="4,1" MinWidth="0" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                    Content="{Binding Name}" ToolTip="{Binding Prefix}" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <TextBlock Text="/" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="1,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding UploadFilesCommand}" ToolTip="Upload files into this folder. You can also drop files and folders on the list.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="Upload files" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Content="Upload folder" Command="{Binding UploadFolderCommand}" ToolTip="Upload a folder and everything in it" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding DownloadCommand}" ToolTip="Download the selected files and folders (Enter on a file)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="Download" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Margin="4,2,8,2" Fill="{StaticResource Chrome.Border}" />
                            <Button Style="{StaticResource ToolButton}" Content="New folder" Command="{Binding NewFolderCommand}" />
                            <Button Style="{StaticResource ToolButton}" Content="Rename" Command="{Binding RenameCommand}" ToolTip="Rename the selected file or folder (F2)" />
                            <Button Style="{StaticResource ToolButton}" Content="Delete" Command="{Binding DeleteCommand}" Foreground="{StaticResource Chrome.Danger}" ToolTip="Delete the selection (Delete)" />
                            <Button Style="{StaticResource ToolButton}" Content="Copy URL" Command="{Binding CopyUrlCommand}" ToolTip="Copy the address of the selected item, or of this folder. Opening it still needs a sign in." />
                            <Rectangle Width="1" Margin="4,2,8,2" Fill="{StaticResource Chrome.Border}" />
                            <Grid Width="200">
                                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12"
                                         AutomationProperties.Name="Filter this folder" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                                <TextBlock Text="Filter by name" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Footer: counts and load more -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Load more" Margin="0" Padding="8,1" Command="{Binding LoadMoreCommand}"
                                Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ListingText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="10,5" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="Modified" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Tier" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Grid x:Name="DropArea" AllowDrop="True" Background="Transparent" DragEnter="DropArea_DragOver" DragOver="DropArea_DragOver" DragLeave="DropArea_DragLeave" Drop="DropArea_Drop">
                    <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" SelectionMode="Extended"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Blobs"
                             SelectionChanged="EntryList_SelectionChanged" MouseDoubleClick="EntryList_MouseDoubleClick" PreviewKeyDown="EntryList_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BlobEntryRow}">
                                <Grid AutomationProperties.Name="{Binding DisplayName}" ToolTip="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource TypedGlyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock x:Name="NameText" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding TierText}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                        <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding EmptyText, Converter={StaticResource StringToVis}}" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding DropHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding HasContainer, Converter={StaticResource InverseBoolToVisLocal}}" IsHitTestVisible="False" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" IsHitTestVisible="False"
                                Visibility="{Binding IsListing, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="3" BorderThickness="0" />
                        <TextBlock Text="Listing..." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Visibility="{Binding HasListingError, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,40,20,0"
                            MaxWidth="560" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="1" CornerRadius="3" Padding="12,10" Background="{StaticResource Chrome.Background}">
                        <StackPanel>
                            <TextBlock Text="{Binding ListingError}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource BarButton}" Content="Try again" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Shown while files are dragged over the list -->
                    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="6" BorderThickness="2" CornerRadius="4"
                            BorderBrush="{StaticResource Chrome.Accent}" Background="#202f7fd6">
                        <TextBlock Text="{Binding DropHint}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="20" />
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Chrome.Border}" />

            <!-- Details -->
            <Border Grid.Column="4" Background="{StaticResource Chrome.Panel}">
                <Grid>
                    <TextBlock Text="Select a file to see its properties and metadata." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="16,40,16,0" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding HasSelectedEntry, Converter={StaticResource InverseBoolToVisLocal}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12">
                            <TextBlock Text="Properties" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding DetailRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                            <TextBlock Text="Metadata" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"
                                       Visibility="{Binding SelectedEntry.IsFolder, Converter={StaticResource InverseBoolToVisLocal}}" />
                            <ItemsControl ItemsSource="{Binding MetadataRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                            <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"
                                       Visibility="{Binding DetailsText, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Transfers -->
        <Border Grid.Row="4" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,5,8,3">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Clear finished" Margin="0" Padding="8,1" Command="{Binding ClearFinishedJobsCommand}" />
                    <TextBlock Text="Transfers" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Jobs}" Margin="10,0,8,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StorageJobViewModel}">
                                <Grid Margin="0,3" AutomationProperties.Name="{Binding Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="200" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="6" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" VerticalAlignment="Center"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock x:Name="StateText" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                               Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisLocal}}" Text="{Binding State}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ProgressText}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Style="{StaticResource BarButton}" Content="Cancel" Margin="0" Padding="8,0" Command="{Binding CancelCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Chrome.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Chrome.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Status line -->
        <Border Grid.Row="5" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource Chrome.Ok}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
        </Border>
    </Grid>
</UserControl>
